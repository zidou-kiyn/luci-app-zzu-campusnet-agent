#!/bin/sh
# /etc/hotplug.d/iface/99-multipath（extras/j1900/j1900-setup.sh 安装）
# 每条线路有自己的路由表（netifd ip4table，按源 IP 选表，保证源 IP 与出口一致）；
# 这里只维护“组表”的多路默认路由，分组见文件末尾 GROUPS（换分组只改那里）：
#   联通组 → main  表：wancm1 + wancm2（31 网段、路由器自身）
#   电信组 → wanct 表：wanct1 + wanct2（32 网段）
# 各线路网关自动取自该线路的默认路由（netifd 写在线路自己的表里），无需配置；
# 组表内没有直连路由，因此 nexthop 用 onlink。
# 故障摘除：认证插件 watchdog 判定线路外网不通（或线路被停用）时写 $DOWN/<设备名>，
# 并以 ACTION=ifup 调用本脚本；有标记的设备不进组路由。
# 组间兜底：某组没有可用线路时借用其它组的可用线路（如联通全挂 → 31 网段临时走电信），
# 本组任一线路恢复后自动切回；所有组都没有可用线路时保留本组全部（有默认路由总比没有好）。
# 借用关系取决于其它组的状态，因此任一线路变化都重建全部组。
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0

. /lib/functions/network.sh
DOWN=/var/run/zzucampusnetagent/down

# 设备的 IPv4 网关：优先取 netifd 写入的默认路由（任意表；跳过本脚本建的多路路由），
# 取不到时按同名逻辑接口查询
gw() {
	local g
	g=$(ip -4 route show table all default dev "$1" 2>/dev/null | awk '$1=="default" && $2=="via" {print $3; exit}')
	[ -n "$g" ] || network_get_gateway g "$1" 2>/dev/null
	echo "$g"
}

# 设备是否可用于路由：已 up、有 IPv4，且不是正在 ifdown 的那个
# （ifdown 时设备可能还带着 IP，须显式排除；否则多路路由含该设备，设备随后被删除时内核会连同整条路由一起删掉）
usable() {
	[ "$ACTION" = "ifdown" ] && [ "$1" = "$DEVICE" -o "$1" = "$INTERFACE" ] && return 1
	ip link show "$1" up >/dev/null 2>&1 || return 1
	[ -n "$(ip -4 -br addr show dev "$1" 2>/dev/null | awk '{print $3}')" ] && [ -n "$(gw "$1")" ]
}

# healthy 设备列表…：输出其中可用且未被摘除的设备
healthy() {
	local d
	for d in "$@"; do usable "$d" && [ ! -e "$DOWN/$d" ] && echo "$d"; done
}

hops() {
	local d
	for d in "$@"; do printf ' nexthop via %s dev %s weight 1 onlink' "$(gw "$d")" "$d"; done
}

# build 表名 本组设备…：其它组的设备取自全局 GROUPS
build() {
	local tbl="$1" own ok all other="" d t devs note=""; shift
	own="$*"
	ok=$(healthy $own)
	all=$(for d in $own; do usable "$d" && echo "$d"; done)
	if [ -z "$ok" ]; then
		other=$(echo "$GROUPS" | while read -r t devs; do
			[ -n "$t" ] && [ "$t" != "$tbl" ] && healthy $devs; done)
		if [ -n "$other" ]; then
			ok="$other"; note=" (own lines all down, borrowing: $(echo $other))"
		elif [ -n "$all" ]; then
			ok="$all"; note=" (all marked down, keep all)"
		fi
	elif [ "$(echo $ok | wc -w)" -lt "$(echo $all | wc -w)" ]; then
		note=", $(( $(echo $all | wc -w) - $(echo $ok | wc -w) )) removed by failover"
	fi
	set -- $ok
	while ip route del default table "$tbl" 2>/dev/null; do :; done
	[ $# -gt 0 ] && ip route add default table "$tbl" $(hops "$@")
	logger -t multipath "$tbl: $# path(s)$note"
}

# 分组：每行“表名 设备…”
GROUPS="main  wancm1 wancm2
wanct wanct1 wanct2"

echo "$GROUPS" | grep -qw -- "$INTERFACE" || exit 0
echo "$GROUPS" | while read -r t devs; do [ -n "$t" ] && build "$t" $devs; done
